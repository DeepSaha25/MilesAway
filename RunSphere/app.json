{
  "expo": {
    "name": "MilesAway",
    "slug": "milesaway",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "milesaway",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "jsEngine": "hermes",
    "android": {
      "package": "com.milesaway.app",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0c0e0f"
      }
    },
    "ios": {
      "bundleIdentifier": "com.milesaway.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MilesAway uses your location to track outdoor runs and show your route."
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MilesAway uses your location to track outdoor runs and show your route."
        }
      ]
    ]
  }
}
