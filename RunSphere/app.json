{
  "expo": {
    "name": "MilesAway",
    "slug": "milesaway",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "milesaway",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "jsEngine": "hermes",
    "runtimeVersion": "0.0.1",
    "updates": {
      "url": "https://u.expo.dev/2ff0b651-54e2-4dbc-b7fc-691d97650a84"
    },
    "android": {
      "package": "com.milesaway.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0c0e0f"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCcFZ09DbswR-yJNfNQKSGJhRWB0xdftJQ"
        }
      },
      "versionCode": 12
    },
    "ios": {
      "bundleIdentifier": "com.milesaway.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MilesAway uses your location to track outdoor runs and show your route.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "MilesAway uses background location to keep tracking active runs when the app is not on screen."
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MilesAway uses your location to track outdoor runs and show your route.",
          "locationAlwaysAndWhenInUsePermission": "MilesAway uses background location to keep tracking active runs when the app is not on screen.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "MilesAway uses motion sensors to improve live run tracking confidence."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2ff0b651-54e2-4dbc-b7fc-691d97650a84"
      }
    }
  }
}
